{
  "name": "bw-server-helper",
  "version": "1.0.0",
  "description": "A Bitwarden server helper for useful tasks (like backup).",
  "author": "Leonardo Marcucci",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build:clean": "run-s clean doc:clean build",
    "build": "run-s nest:build doc",
    "clean": "rimraf dist",
    "cross-env": "cross-env",
    "depcheck": "pnpm exec depcheck",
    "doc:build": "compodoc",
    "doc:clean": "rimraf docs/compodoc",
    "doc:serve": "compodoc -s",
    "doc": "run-s doc:clean doc:build",
    "docker:hub:desc": "cross-env-shell docker run -v $PWD/README.md:/workspace/README.md -e DOCKERHUB_USERNAME='${DOCKERHUB_USER}' -e DOCKERHUB_PASSWORD='${DOCKERHUB_PAT}' -e DOCKERHUB_REPOSITORY='marcuson/bw-server-helper' -e README_FILEPATH='/workspace/README.md' -e SHORT_DESCRIPTION=\\\"Utilities for Bitwarden server management\\\" peterevans/dockerhub-description:4.0.0",
    "docker:local:build": "cross-env-shell docker buildx build -f Dockerfile -t marcuson/bw-server-helper:latest-local --load .",
    "docker:local:compose": "docker compose -f compose.yml",
    "docker:local:dive": "dive marcuson/bw-server-helper:latest-local",
    "docker:multiarch:build-push": "cross-env-shell docker buildx build -f Dockerfile --platform linux/amd64,linux/arm64 -t marcuson/bw-server-helper:$VER -t marcuson/bw-server-helper:$LVER --push .",
    "docker:slim": "slim build --http-probe-off --preserve-path-file ignore.txt marcuson/bw-server-helper:0.0.0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "g:api-pregen:bwvaultman:download": "node scripts/download-vault-management-api.mjs",
    "g:api-pregen:bwvaultman:clean": "rimraf src/features/bitwarden/model",
    "g:api-pregen:bwvaultman": "run-s g:api-pregen:bwvaultman:download g:api-pregen:bwvaultman:clean",
    "g:api-gen:bwvaultman": "docker run --rm --net=host -u=\"$(id -u)\" -v ${PWD}:/local openapitools/openapi-generator-cli generate -i /local/api-defs/vault-management-api.json --global-property models --skip-validate-spec -g typescript-nestjs -o /local/src/features/bitwarden",
    "g:api-gen:bwcli": "docker run --rm --net=host -u=\"$(id -u)\" -v ${PWD}:/local openapitools/openapi-generator-cli generate -i /local/api-defs/bitwarden-cli-models.json --global-property models -g typescript-nestjs -o /local/src/features/bitwarden",
    "g:api-all:pregen": "run-p g:api-pregen:*",
    "g:api-all:gen": "run-p g:api-gen:*",
    "g:api": "run-s g:api-all:pregen g:api-all:gen",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "ncu": "pnpm exec ncu",
    "nest:build": "nest build",
    "nest:start:debug": "nest start --watch --debug=0.0.0.0:9229",
    "nest:start:dev": "nest start --watch",
    "nest:start:prod": "node dist/src/main",
    "nest:start": "nest start",
    "nest": "nest",
    "release:prepare": "run-s 'cross-env VER={1} LVER={2} run-s \"docker:multiarch:build-push\"' -- ",
    "release:publish": "run-s 'cross-env VER={1} LVER={2} run-s \"docker:hub:desc\"' -- ",
    "release": "semantic-release",
    "start:debug": "pnpm run nest:start:debug",
    "start:dev": "pnpm run nest:start:dev",
    "start:prod": "pnpm run nest:start:prod",
    "start": "pnpm run nest:start",
    "test:clear": "jest --clearCache",
    "test:cov": "pnpm run test:run --coverage",
    "test:debug": "cross-env NODE_OPTIONS='--inspect-brk=0.0.0.0:9229 --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register' jest --runInBand --config ./test/jest.config.ts",
    "test:e2e:debug": "pnpm run test:debug --selectProjects e2e",
    "test:e2e": "pnpm run test:run --selectProjects e2e",
    "test:ext:debug": "jest --config ./test/jest.config.ts",
    "test:integration": "node test/integration/runtime.cjs enabled && node test/integration/runtime.cjs disabled",
    "test:prep": "run-s test:clear test:trans:build",
    "test:release": "node test/integration/release.mjs",
    "test:run": "cross-env NODE_OPTIONS='--experimental-vm-modules -r tsconfig-paths/register -r ts-node/register' jest --config ./test/jest.config.ts",
    "test:trans:build": "tsc --esModuleInterop --outDir ./test/transformers/build test/transformers/*.ts",
    "test:unit:debug": "pnpm run test:debug --selectProjects unit",
    "test:unit": "pnpm run test:run --selectProjects unit",
    "test:watch": "pnpm run test:run --watch",
    "test": "pnpm run test:unit"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@zip.js/zip.js": "^2.15.0",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^2.0.0",
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "chalk": "^6.0.0",
    "ci-info": "^4.4.0",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "inquirer": "^14.2.2",
    "jest": "^30.5.1",
    "make-dir-cli": "^4.0.0",
    "node-mocks-http": "^1.18.1",
    "npm-check-updates": "^23.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "webpack": "^5.111.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@12.4.2"
}
